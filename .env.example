# Pageant Docker Configuration
# Copy this file to .env and customize as needed

# Port to expose Pageant on (default: 8080)
PAGEANT_PORT=8080

# Where to store generated images on your host machine
# Default: ./output (relative to docker-compose.yml)
# Recommended: Use absolute path like ~/Pictures/Pageant for easy access
PAGEANT_OUTPUT_DIR=./output

# Path to your Gemini API key file
# Default: ~/.gemini/apikey.txt
GEMINI_API_KEY_FILE=~/.gemini/apikey.txt

# Or set the API key directly (alternative to file)
# GEMINI_API_KEY=your-api-key-here

# Enable semantic image search (requires ~1.5GB embedding model download)
ENABLE_SEARCH=true

# Host path for "Open Folder" button (optional)
# Set this to the absolute path of PAGEANT_OUTPUT_DIR on your host machine
# Example: /Users/yourname/Pictures/Pageant
# If not set, "Open Folder" will show the path for manual navigation
IMAGES_HOST_PATH=
